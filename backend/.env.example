TERRA360_ENV=development
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# Calca town reference point (not a farm parcel centroid)
PILOT_LATITUDE=-13.32175
PILOT_LONGITUDE=-71.95605
PILOT_NAME=Calca, Cusco, Peru

# Required only for GPM IMERG download. Never commit your real token.
EARTHDATA_TOKEN=

# Comma-separated list of actual frontend origins, without paths or trailing slashes.
# Example: CORS_ORIGINS=https://terra360.example.com,https://www.terra360.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In public deployments disable large Earthdata downloads until protected/limited.
GPM_DOWNLOADS_ENABLED=true

# Off by default: the API serves prepared JSON reports without torch/Chronos.
# Enable only on a machine with requirements-ml.txt and cached model weights.
CHRONOS_INFERENCE_ENABLED=false
# Optional absolute directory for small forecast reports, NOT model weights.
# RAIN_FORECAST_REPORT_DIR=/absolute/path/to/rain_forecasts

# Optional operator-prepared risk snapshot directory. No public downloads.
# RISK_ALERTS_DATA_DIR=/absolute/path/to/risk_alerts
