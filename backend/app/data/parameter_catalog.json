      "origin": "farmer_reported",
      "source_ids": [],
      "spatial_level": "plot",
      "integration": "optional_input",
      "decision_role": "Restricciones químicas a revisar",
      "limitation": "Sin prueba y rangos del cultivo no se declara aptitud"
    },
    {
      "id": "soil_organic_matter",
      "farmer_label": "Materia orgánica del suelo",
      "unit": "%",
      "origin": "farmer_reported",
      "source_ids": [],
      "spatial_level": "plot",
      "integration": "optional_input",
      "decision_role": "Contexto de salud del suelo",
      "limitation": "No implica cuantificar carbono ni mejoras"
    },
    {
