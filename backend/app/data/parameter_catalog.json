      "source_ids": [
        "srtm"
      ],
      "spatial_level": "pixel_30m",
      "integration": "research_not_integrated",
      "decision_role": "Revisión de erosión y trabajo en laderas",
      "limitation": "No es tasa de pérdida de suelo"
    },
    {
      "id": "et0",
      "farmer_label": "Demanda atmosférica de agua",
      "unit": "mm/día",
      "origin": "computed",
      "source_ids": [
        "fao56",
        "power"
      ],
      "spatial_level": "regional",
      "integration": "research_not_integrated",
      "decision_role": "Explicar demanda ambiental",
      "limitation": "Sin variables y método comprobado no usar para prescribir riego"
    },
    {
      "id": "etc",
      "farmer_label": "Agua usada por un cultivo de referencia",
      "unit": "mm/día",
      "origin": "computed",
      "source_ids": [
        "fao56"
      ],
      "spatial_level": "field_model",
      "integration": "not_evaluable",
      "decision_role": "Demanda potencial por etapa",
      "limitation": "Necesita Kc por etapa y fechas fiables; no es riego requerido"
    },
    {
      "id": "soil_texture",
      "farmer_label": "Tipo de suelo",
      "unit": "categoría",
      "origin": "farmer_reported",
      "source_ids": [],
      "spatial_level": "plot",
      "integration": "optional_input",
      "decision_role": "Contexto de retención e infiltración",
      "limitation": "Dato no verificado salvo análisis"
    },
    {
      "id": "soil_ph",
      "farmer_label": "Acidez del suelo",
